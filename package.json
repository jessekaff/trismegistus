{
  "name": "trismegistus",
  "version": "1.1.2",
  "description": "A local persistent daemon that runs AI sessions from a task queue, with mobile support.",
  "type": "module",
  "bin": {
    "tmg": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "task-manager",
    "daemon",
    "automation",
    "ai"
  ],
  "author": "jessekaff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessekaff/trismegistus.git"
  },
  "homepage": "https://github.com/jessekaff/trismegistus#readme",
  "bugs": {
    "url": "https://github.com/jessekaff/trismegistus/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
